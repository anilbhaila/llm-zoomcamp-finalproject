{
  "name": "Ubuntu UV Project",
  "build": {
    "dockerfile": "../Dockerfile.python"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "uv sync && uv run python -m spacy download en_core_web_sm"
}